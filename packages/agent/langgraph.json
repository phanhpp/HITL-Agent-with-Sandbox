{
  "python_version": "3.12",
  "graphs": {
    "human_in_the_loop": "./agents/human_in_the_loop.py:agent",
    "orchestrator": "./agents/orchestrator.py:agent"
  },
  "env": ".env",
  "source": {
    "kind": "uv"
  },
  "http": {
    "app": "./http_app.py:app"
  },
  "checkpointer": {
    "ttl": {
      "strategy": "delete",
      "default_ttl": 1440,
      "sweep_interval_minutes": 10
    }
  }
}
