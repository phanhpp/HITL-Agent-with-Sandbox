# Copy to .env.local. Both values are server-only: never prefix with NEXT_PUBLIC_,
# or they end up in the browser bundle.

# Local: the langgraph dev server (make dev-agent).
# Production: your LangSmith Deployment URL, e.g. https://<id>.us.langgraph.app
AGENT_SERVER_URL=http://127.0.0.1:2024

# Leave unset locally — `langgraph dev` needs no auth.
# Required in production; sent as the X-Api-Key header by the proxy route.
# LANGSMITH_API_KEY=

# The shared password for the deployed demo (proxy.ts, app/api/login). Every message spends
# the owner's model credit, so a public deploy needs this. Required in production: with it
# unset, a production build refuses everyone. Unset locally and the app is open.
# WEB_PASSWORD=
