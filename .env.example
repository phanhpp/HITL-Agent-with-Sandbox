# Required: your Anthropic API key
ANTHROPIC_API_KEY=your-api-key-here

# Required once /orchestrate delegates to the coder: LangSmith Sandboxes
# authenticate with the same key as LangSmith Deployments.
LANGSMITH_API_KEY=

# Optional: cheaper models for a test run. Defaults are Sonnet 5 for the
# supervisor and coder, Haiku 4.5 for the research workers.
# ORCHESTRATE_CODER_MODEL=anthropic:claude-haiku-4-5
