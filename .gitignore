# Python
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/
.next/
dist/
# Generated by next dev/build/typegen, and the two write different paths into it, so a
# tracked copy flips every time you switch between them. Next's own docs say to ignore it.
next-env.d.ts

# Secrets
.env
.env.local
.env.*.local

# LangGraph dev server state (in-memory threads, checkpoints)
packages/agent/.langgraph_api/

# OS / editor
.DS_Store
*.swp
.idea/

# Personal notes stay local. The four curated docs are tracked anyway, force-added
# once with `git add -f`:  BUILD.md  LESSONS.md  TESTING.md  deepagent_subagent.md
# `git add docs/` will NOT pick up a new file here -- use -f if you mean to track it.
docs/
# TypeScript build cache
*.tsbuildinfo

# setuptools build artifact from the editable install
*.egg-info/
