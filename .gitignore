# Python
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/
.next/
dist/
# Generated by next dev/build/typegen, and the two write different paths into it, so a
# tracked copy flips every time you switch between them. Next's own docs say to ignore it.
next-env.d.ts

# Secrets
.env
.env.local
.env.*.local

# LangGraph dev server state (in-memory threads, checkpoints)
packages/agent/.langgraph_api/

# OS / editor
.DS_Store
*.swp
.idea/

# Local Claude Code config and skills -- machine-specific, not part of the app.
.claude/

# Personal notes stay local. A few curated docs are tracked anyway, force-added once
# with `git add -f` -- see `git ls-files docs/` for which.
# `git add docs/` will NOT pick up a new file here -- use -f if you mean to track it.
docs/
# Playwright run artifacts (reports, traces, screenshots)
playwright-report/
test-results/

# TypeScript build cache
*.tsbuildinfo

# setuptools build artifacts
*.egg-info/
build/
